PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
APP_ORIGIN=https://radarfacial.com.br
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
ADMIN_EMAILS=admin@radarfacial.com.br
MERCADOPAGO_TOKEN=
FACECHECK_API_KEY=

# Programa de criadores: manter desativado até aplicar migrações e validar homologação.
CREATOR_PROGRAM_ENABLED=false
# JSON: e-mail administrativo normalizado -> segredo TOTP Base32 (mínimo 32 caracteres).
# Provisionar segredos individuais no gerenciador de segredos, nunca versionar valores reais.
ADMIN_TOTP_SECRETS={}
MAX_ADMIN_GRANT=1000
# Segredo da assinatura do webhook; diferente do token de acesso Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# Rota /teste: somente a conta Google autorizada no backend; false desativa.
TEST_CREDIT_ENABLED=true
